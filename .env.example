# ---------- Database (Supabase -> Project Settings -> Database -> Connection string) ----------
# On Vercel use the "Transaction pooler" string (port 6543). On your own server either one works.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ---------- Login security ----------
# Any long random text (40+ characters). Keep it secret. Changing it logs everyone out.
JWT_SECRET=change-this-to-a-long-random-string-1234567890abcdef

# ---------- File storage for vendor bill photos ----------
# supabase = Supabase Storage (needed on Vercel) | local = folder on your own server
STORAGE=supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=bills

# Only for STORAGE=local (own server)
# UPLOAD_DIR=./uploads
# UPLOAD_LIMIT=20mb

# Own server only
# PORT=3000
